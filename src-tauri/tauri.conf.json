{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NWN Skript Generator",
  "identifier": "com.nwnscriptgenerator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NWN Skript Generator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["../binaries/nwnsc"],
    "resources": {
      "../THIRD_PARTY_LICENSES/nwnsc.txt": "THIRD_PARTY_LICENSES/nwnsc.txt"
    }
  }
}
